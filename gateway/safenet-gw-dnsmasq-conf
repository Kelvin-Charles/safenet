#!/bin/bash
# Writes the dnsmasq config for the guest network to $1.
# DHCP is only served when DHCP_ENABLED=yes, so the gateway can be installed
# while the access point still runs its own DHCP server.
set -euo pipefail
: "${LAN_IFS:?}" "${LAN_ADDR:?}" "${DHCP_START:?}" "${DHCP_END:?}"
out="$1"

{
    echo "# Generated by safenet-gw-dnsmasq-conf - edit /etc/safenet-gateway/gateway.env instead"
    echo "port=53"
    echo "bind-dynamic"
    for i in $LAN_IFS; do echo "interface=$i"; done
    echo "except-interface=lo"
    echo "no-resolv"
    for s in ${UPSTREAM_DNS:-1.1.1.1 8.8.8.8}; do echo "server=$s"; done
    echo "domain-needed"
    echo "bogus-priv"
    echo "cache-size=2000"
    echo "address=/login.wifi/$LAN_ADDR"
    if [[ "${DHCP_ENABLED:-no}" == "yes" ]]; then
        echo "dhcp-authoritative"
        echo "dhcp-range=$DHCP_START,$DHCP_END,${DHCP_LEASE:-12h}"
        echo "dhcp-option=option:router,$LAN_ADDR"
        echo "dhcp-option=option:dns-server,$LAN_ADDR"
        echo "dhcp-leasefile=/var/lib/misc/safenet-gw.leases"
    fi
} > "$out"
