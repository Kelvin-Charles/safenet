# SafeNet captive-portal gateway settings (/etc/safenet-gateway/gateway.env)
# After editing: sudo systemctl restart safenet-gw-firewall safenet-gw-dns

# Guest side (Wi-Fi joined to the access point) and internet side
LAN_IFS="wlp3s0"
WAN_IF="enp2s0"

# Gateway address on the guest network; guests get DHCP_START..DHCP_END
LAN_ADDR="10.10.0.1"
LAN_PREFIX="24"
DHCP_START="10.10.0.50"
DHCP_END="10.10.0.250"
DHCP_LEASE="12h"
# Keep "no" until the access point's own DHCP server is switched off
DHCP_ENABLED="no"
UPSTREAM_DNS="1.1.1.1 8.8.8.8"

# Splash page
PORTAL_PORT="80"
HOTSPOT_NAME="SafeNet WiFi"
HOTSPOT_SUPPORT=""
# HOTSPOT_TERMS="..."

# Older RADIUS login path, used only when no SAFENET_API_KEY is set
# (or AUTH_MODE="radius"); this network's public IP must be a client there.
RADIUS_SERVER="schoolhub.space"
RADIUS_AUTH_PORT="1812"
RADIUS_ACCT_PORT="1813"
RADIUS_SECRET=""
NAS_IDENTIFIER="safenet-gateway"

# SafeNet cloud: create a key under Gateways and paste it here. The gateway then
# logs guests in, reports usage, sells packages and uses your branding over HTTPS.
SAFENET_API_URL="https://radius.safezonetz.com"
SAFENET_API_KEY=""

# Used when SafeNet sends no Session-Timeout (plain users); hard upper limit
DEFAULT_SESSION_SECONDS="3600"
MAX_SESSION_SECONDS="604800"
ACCT_INTERIM_SECONDS="60"

# Block guests from sharing their access through their own phone/laptop hotspot
# (overridden by the tenant's setting in SafeNet when SAFENET_API_KEY is set)
BLOCK_TETHERING="yes"
