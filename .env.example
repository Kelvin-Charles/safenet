# Copy to ".env" in this directory: cp .env.example .env
# Docker Compose requires these for MariaDB (no default passwords in compose).

DB_ROOT_PASSWORD=SiriNywila321
DB_PASSWORD=SiriNywila321

# Optional (defaults match docker-compose.yml)
# DB_NAME=radius
# DB_USER=radius

# --- If you see: Access denied for user 'radius'@'...' (using password: YES) ---
# MariaDB only creates the app user password when the data volume is first created.
# If you later change DB_PASSWORD in .env, the database user still has the OLD password.
# Fix once (requires correct DB_ROOT_PASSWORD in .env):
#   ./scripts/manage.sh sync-mysql-password
#   docker compose restart web freeradius phpmyadmin
# Or set DB_PASSWORD in .env back to whatever was used when the volume was first created.

# Guest Wi-Fi branding: public /portal page and printed vouchers
HOTSPOT_NAME=SafeNet WiFi
HOTSPOT_SSID=TP-LINK_D1DD
HOTSPOT_SUPPORT=
HOTSPOT_CURRENCY=TZS

# ClickPesa (buy packages on the captive portal). No sandbox: every payment is real.
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
# Only if "checksum" is enabled for your ClickPesa application
CLICKPESA_CHECKSUM_KEY=
# Random secret shared with captive-portal gateways (SAFENET_API_KEY in gateway.env)
# e.g. python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PORTAL_API_KEY=

# Multi-tenant signup (links in emails use PUBLIC_URL)
PUBLIC_URL=https://radius.safezonetz.com
SIGNUP_ENABLED=true
TRIAL_DAYS=14

# Required: signs logins and emailed links. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts tenants' payment keys. python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
# Platform-collected payments: default fee (%) and minimum withdrawal
PLATFORM_FEE_PERCENT=0
MIN_WITHDRAWAL=5000
